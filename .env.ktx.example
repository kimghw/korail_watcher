# ============================================================
# .env.ktx.example — 실값 없는 양식 (git tracked)
# 사용법: 이 파일을 `.env.ktx` 로 복사한 뒤 <...> 자리에 실값 입력.
#   `.env.ktx` 는 자격증명·카드정보가 들어가므로 .gitignore (커밋 금지).
# ============================================================

# ============================================================
# 자격증명
# ============================================================
SRT_USER=<SRT 회원번호>
SRT_PASS=<SRT 비밀번호>
KTXA_USER=<코레일 회원번호>
KTXA_PASS=<코레일 비밀번호>
# KE 스카이패스 (이메일 또는 회원번호)
KOREAN_AIR_USER=<대한항공 ID>
KOREAN_AIR_PASS=<대한항공 비밀번호>

# ============================================================
# 결제 정보 (KTX/SRT 공통 카드)
# ============================================================
# SRT 결제 활성화
PAYMENT_MODE=false
# 카드번호: 하이픈 4등분
PAY_CARD_NUM=9999-9999-9999-9999
# 유효기간(월/년): 월은 01..12, 년은 2025..2037
PAY_CARD_MM=12
PAY_CARD_YY=2027
# 카드 비밀번호 앞 2자리
PAY_CARD_PW2=00
# 인증번호(주민등록번호 앞 6자리, YYMMDD)
PAY_ID6=000000
# 카드사
PAY_CARD_COMPANY=<카드사명>

# ============================================================
# KTX 여정
# ============================================================
KTXA_ORIGIN=서울
KTXA_DEST=부산
KTXA_DATE=2026-01-01
KTXA_TIMES=09:00
KTXA_TOLERANCE_MIN=30
KTXA_TIME_WINDOW=09:00,10:00
KTXA_PASSENGERS=1
# 승객 유형: 어른(기본) / 어린이 / 유아 / 경로 / 중증장애인 / 경증장애인 / 국가유공자
#   단일 유형명이면 KTXA_PASSENGERS 명 전원 그 유형 (예: 경로 → 경로 1명)
#   혼합은 "어른:1,경로:1" 형식 (이때 KTXA_PASSENGERS 무시)
KTXA_PASSENGER_TYPE=어른
KTXA_SEAT_CLASS=일반실
# 좌석으로 한 번에 가는 열차만 (입석+좌석/예약대기 제외)
KTXA_SEATED_ONLY=true
KTXA_TRAIN_NO=

# ============================================================
# KTX 전용 (열차 종류 필터; SRT 에는 해당 없음)
# ============================================================
KTXA_TRAIN_TYPE=KTX

# ============================================================
# 승차권 전달하기 (발권 완료 후 자동 전달)
# ============================================================
# 발권 후 전달 흐름 실행 여부
KTXA_TRANSFER_ENABLED=false
# false 면 수신자 입력까지만 하고 '전송하기' 직전에 중단 (dry-run)
KTXA_TRANSFER_SEND=false
# 수신자 3종 (회원번호 + 이름 + 휴대폰)
KTXA_TRANSFER_MEMBER_NO=<수신자 코레일 회원번호>
KTXA_TRANSFER_NAME=<수신자 이름>
KTXA_TRANSFER_PHONE=<수신자 휴대폰 01000000000>

# ============================================================
# KTX-A 워처 동작 (mode / payment / poll / log)
# ============================================================
KTXA_MODE=search
KTXA_PAYMENT_MODE=false
KTXA_ONCE=false
KTXA_POLL_MIN=3
KTXA_POLL_MAX=5
KTXA_LOG_DIR=./runs
KTXA_LOG_LEVEL=INFO

# ============================================================
# SRT 여정 → `.env.srt` 별도 파일에서 관리
# ============================================================

# ============================================================
# SRT 워처 동작 (poll / mode / log)
# ============================================================
# 다음 검색까지 최소/최대 대기 시간(초), 사이에서 랜덤으로 쉰다
SRT_POLL_MIN=1
SRT_POLL_MAX=5

# true이면 한 번 검색/예약 시도 후 종료, false이면 계속 반복
SRT_ONCE=false

# 로그 및 artifacts 저장 루트 디렉토리
SRT_LOG_DIR=./runs

# 로그 레벨 (DEBUG / INFO / WARNING / ERROR)
SRT_LOG_LEVEL=INFO

# 동작 모드: search(조회만) / reserve(자동 예약)
SRT_MODE=search

# ============================================================
# 브라우저 모드 1) Playwright (내장 Chromium, 헤드리스 옵션)
#                — SRT 기본 모드. SRT_CDP_URL 이 비어 있으면 이쪽으로 동작.
# ============================================================
# Playwright headless 모드 (true=브라우저 창 안 뜸)
SRT_HEADLESS=true

# ============================================================
# 브라우저 모드 2) CDP (이미 실행 중인 Chrome 의 디버깅 포트에 연결)
#                — KTX 는 강제(필수). SRT 는 SRT_CDP_URL 설정 시 활성.
# ============================================================
# ─ KTX-A CDP ─
KTXA_CDP_PORT=9444
KTXA_CDP_USER_DATA_DIR=C:\Users\<사용자>\chrome-ktx-watcher
KTXA_CDP_STARTUP_TIMEOUT=20

# ─ SRT CDP (선택) ─
# 비워두면 Playwright 모드. 값이 있으면 그 Chrome 에 붙음.
#   예) http://localhost:9555
SRT_CDP_URL=

# ─ KE CDP (필수) ─
KOREAN_AIR_CDP_PORT=9446
KOREAN_AIR_CDP_USER_DATA_DIR=C:\Users\<사용자>\chrome-air-watcher
KOREAN_AIR_CDP_STARTUP_TIMEOUT=20

# ============================================================
# KE 여정 → `.env.korean_air` 별도 파일에서 관리
# ============================================================

# ============================================================
# KE 워처 동작 (mode / poll / log)
# ============================================================
# search(조회만) / reserve(좌석 hold까지 — 현재 미구현)
KOREAN_AIR_MODE=search
KOREAN_AIR_ONCE=false
KOREAN_AIR_POLL_MIN=5
KOREAN_AIR_POLL_MAX=15
KOREAN_AIR_LOG_DIR=./runs
KOREAN_AIR_LOG_LEVEL=INFO

# ============================================================
# Microsoft Teams 알림 (team_mcp 사용)
# ============================================================
# Teams 알림 활성화 여부
TEAMS_ENABLED=false

# [보내는 주체] 인증된 사용자 이메일. 비워두면 auth.db 의 첫 번째 등록 사용자.
TEAMS_USER_EMAIL=<회사 이메일>

# [받는 대상] Teams 채팅 ID. 형식 예시:
#   - 48:notes                                → 나의 Notes (self, 본인에게)
#   - 19:<guid>_<guid>@unq.gbl.spaces        → 1:1 채팅
#   - 19:<thread>@thread.v2                  → 그룹 채팅 / 팀 채널
# 비워두면 자동으로 48:notes (나에게) 로 전송됨.
TEAMS_CHAT_ID=48:notes

# (선택) TEAMS_CHAT_ID 가 비어 있을 때, 이름(한글/영문)으로 채팅 검색.
# 사전에 team_mcp 로 sync_chats 가 한 번 실행되어 있어야 함.
TEAMS_RECIPIENT_NAME=

# 메시지 앞에 붙는 prefix
TEAMS_PREFIX=[KTX-A WATCHER]

# ============================================================
# Azure AD OAuth (team_mcp 가 Graph API 호출 시 사용)
# ============================================================
AZURE_CLIENT_ID=<Azure 앱 client id>
AZURE_CLIENT_SECRET=<Azure 앱 client secret>
AZURE_TENANT_ID=<Azure tenant id>
AZURE_REDIRECT_URI=http://localhost:5000/callback
AZURE_AUTHORITY=https://login.microsoftonline.com
AZURE_SCOPES=User.Read Mail.Read Mail.Send Mail.ReadWrite Calendars.ReadWrite offline_access

# team_mcp 가 사용할 auth.db (이 프로젝트에 자체 보관)
DB_PATH=<프로젝트 경로>/team_mcp/database/auth.db
