# KE 여정 — `.env` 와 별도 관리 (git tracked, secret 없음)
# outbound leg (갈때). roundtrip 운영은 두 워처를 별도로 띄운다:
#   1) 본 파일 (.env.korean_air) — outbound, 기본 CDP 포트 9446
#   2) .env.korean_air.return  — return,   별도 CDP 포트 9447, 다른 user_data_dir

# 편도(oneway) / 왕복(roundtrip)
KOREAN_AIR_TRIP_TYPE=oneway

# 일반운임(cash) / 보너스(miles) / 둘 다(both)
KOREAN_AIR_FARE_TYPE=miles

# IATA 3-letter (e.g. GMP, ICN, CJU, PUS, NRT, LAX)
KOREAN_AIR_ORIGIN=CJU
KOREAN_AIR_DEST=GMP

# 출발 일정 (YYYY-MM-DD / HH:MM)
KOREAN_AIR_DEPART_DATE=2026-05-29
KOREAN_AIR_DEPART_TIMES=13:05
KOREAN_AIR_DEPART_TIME_WINDOW=12:55,13:15

# 왕복일 때만
KOREAN_AIR_RETURN_DATE=
KOREAN_AIR_RETURN_TIMES=
KOREAN_AIR_RETURN_TIME_WINDOW=

# economy / prestige / first (비워두면 ANY)
KOREAN_AIR_CABIN=

# 인원
KOREAN_AIR_PAX_ADULT=1
KOREAN_AIR_PAX_CHILD=0
KOREAN_AIR_PAX_INFANT=0

# 시간 매칭 허용 오차(분)
KOREAN_AIR_TOLERANCE_MIN=10
# 특정 편명 (e.g. KE1207, 또는 콤마로 여러 개 KE1214,KE5208) — 비어있으면 시간 매칭만
KOREAN_AIR_FLIGHT_NO=KE1214

# Teams 알림 prefix (`.env` 의 [binjari] 를 KE 전용으로 덮어쓰기)
TEAMS_PREFIX=[KOREAN WATCHER]
