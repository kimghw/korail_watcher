# KE 여정 — `.env` 와 별도 관리 (git tracked, secret 없음)

# 편도(oneway) / 왕복(roundtrip)
AIR_TRIP_TYPE=oneway

# 일반운임(cash) / 보너스(miles) / 둘 다(both)
AIR_FARE_TYPE=cash

# IATA 3-letter (e.g. GMP, ICN, CJU, PUS, NRT, LAX)
AIR_ORIGIN=CJU
AIR_DEST=GMP

# 출발 일정 (YYYY-MM-DD / HH:MM)
AIR_DEPART_DATE=2026-05-29
AIR_DEPART_TIMES=13:05
AIR_DEPART_TIME_WINDOW=12:35,13:35

# 왕복일 때만
AIR_RETURN_DATE=
AIR_RETURN_TIMES=
AIR_RETURN_TIME_WINDOW=

# economy / prestige / first (비워두면 ANY)
AIR_CABIN=economy

# 인원
AIR_PAX_ADULT=1
AIR_PAX_CHILD=0
AIR_PAX_INFANT=0

# 시간 매칭 허용 오차(분)
AIR_TOLERANCE_MIN=30

# 특정 편명 (e.g. KE1207) — 비어있으면 시간 매칭만
AIR_FLIGHT_NO=
