# Required credentials
SRT_USER=0000570000
SRT_PASS=real_password

# Required trip details
SRT_ORIGIN=수서
SRT_DEST=부산
SRT_DATE=2025-12-29
SRT_TIMES=09:20,09:00

# 예매 인원
SRT_PASSENGERS=1

# 좌석 등급 ("일반실" 또는 "특실")
SRT_SEAT_CLASS="일반실"

# Payment
PAYMENT_MODE=true
# 카드번호: 하이픈 4등분
PAY_CARD_NUM=0000-0000-0000-0000
# 유효기간(월/년): 월은 01..12, 년은 2025..2037
PAY_CARD_MM=12
PAY_CARD_YY=2037
# 카드 비밀번호 앞 2자리
PAY_CARD_PW2=37
# 인증번호(주민등록번호 앞 6자리, YYMMDD)
PAY_ID6=931007

# ============================================================
# Microsoft Teams 알림 (team_mcp 사용)
# ============================================================
TEAMS_ENABLED=true

# [보내는 주체] 인증된 사용자 이메일 (auth.db 등록된 계정).
# 비워두면 auth.db 의 첫 번째 등록 사용자.
TEAMS_USER_EMAIL=

# [받는 대상] Teams 채팅 ID:
#   48:notes                       → 본인에게 (나의 Notes)
#   19:<guid>_<guid>@unq.gbl.spaces → 1:1 채팅
#   19:<thread>@thread.v2          → 그룹/팀 채널
# 비워두면 자동으로 48:notes (본인에게).
TEAMS_CHAT_ID=

# (선택) chat_id 없을 때 이름으로 채팅 검색.
TEAMS_RECIPIENT_NAME=

TEAMS_PREFIX=[SRT WATCHER]

# Azure AD OAuth (team_mcp Graph API 호출용)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI=http://localhost:5000/callback
AZURE_AUTHORITY=https://login.microsoftonline.com
AZURE_SCOPES=User.Read Mail.Read Mail.Send Mail.ReadWrite Calendars.ReadWrite Chat.Read Chat.ReadWrite ChatMessage.Send offline_access openid

# team_mcp 가 사용할 auth.db 경로 (이 프로젝트 내부)
DB_PATH=./team_mcp/database/auth.db

# Optional defaults
# 선호 시간과의 허용 오차 (분)
SRT_TOLERANCE_MIN=0

# Playwright headless 모드 (true면 브라우저 창 안 뜸)
SRT_HEADLESS=true

# 다음 검색까지 최소/최대 대기 시간(초), 사이에서 랜덤으로 쉰다
SRT_POLL_MIN=1
SRT_POLL_MAX=5

# true이면 한 번 검색/예약 시도 후 종료, false이면 계속 반복
SRT_ONCE=false

# 로그 및 artifacts 저장 루트 디렉토리
SRT_LOG_DIR=/app/runs

# 로그 레벨 (DEBUG / INFO / WARNING / ERROR)
SRT_LOG_LEVEL=INFO

# 동작 모드: search(조회만) / reserve(자동 예약)
SRT_MODE=reserve

# ============================================================
# KTX Watcher A — korail.com SPA (Playwright) — ktx_watcher_spa/
# ============================================================
KTXA_USER=0000000000
KTXA_PASS=real_password

KTXA_ORIGIN=서울
KTXA_DEST=부산
KTXA_DATE=2026-05-15
KTXA_TIMES=08:00,08:30
# KTXA_TIME_WINDOW=07:00,09:00

KTXA_PASSENGERS=1
# 좌석 등급 ("일반실" 또는 "특실")
KTXA_SEAT_CLASS=일반실
KTXA_TRAIN_TYPE=KTX

KTXA_TOLERANCE_MIN=0
KTXA_HEADLESS=true

KTXA_POLL_MIN=3
KTXA_POLL_MAX=10
KTXA_BACKOFF_CAP=60
KTXA_BACKOFF_MULTIPLIER=2.0
KTXA_BACKOFF_JITTER=0.3

KTXA_ONCE=false
KTXA_LOG_DIR=./runs
KTXA_LOG_LEVEL=INFO
KTXA_MODE=reserve
