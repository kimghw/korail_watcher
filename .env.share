# ============================================================
# 여정 정보 — KTX/SRT 공통 (양쪽 워처가 fallback 으로 읽음)
# ============================================================
RAIL_ORIGIN=서울
RAIL_DEST=부산
RAIL_DATE=2026-05-17
RAIL_TIMES=10:30
RAIL_TIME_WINDOW=09:00,12:00
RAIL_PASSENGERS=1
RAIL_SEAT_CLASS=일반실
RAIL_TOLERANCE_MIN=0

# 열차번호 (예: 034, "KTX 034", "SRT 365"). 비워도 됨.
# 워처는 시간 매칭이라 코드가 직접 사용하진 않고 — skill / 사용자 확인용 메타.
RAIL_TRAIN_NO=

# ============================================================
# SRT/KRX 자격증명
# ============================================================
SRT_USER=0000000000
SRT_PASS=your_srt_password
KTXA_USER=0000000000
KTXA_PASS=your_ktx_password

# ============================================================
# 결제 정보 (KTX/SRT 공통 카드)
# ============================================================
# SRT 결제 활성화
PAYMENT_MODE=false
# 카드번호: 하이픈 4등분
PAY_CARD_NUM=0000-0000-0000-0000
# 유효기간(월/년): 월은 01..12, 년은 2025..2037
PAY_CARD_MM=12
PAY_CARD_YY=2027
# 카드 비밀번호 앞 2자리
PAY_CARD_PW2=00
# 인증번호(주민등록번호 앞 6자리, YYMMDD)
PAY_ID6=000000

# ============================================================
# KTX 전용 (열차 종류 필터; SRT 에는 해당 없음)
# ============================================================
KTXA_TRAIN_TYPE=KTX

# ============================================================
# KTX-A 워처 동작 (mode / payment / poll / log)
# ============================================================
KTXA_MODE=reserve
KTXA_PAYMENT_MODE=true
KTXA_ONCE=false
KTXA_POLL_MIN=3
KTXA_POLL_MAX=10
KTXA_LOG_DIR=./runs
KTXA_LOG_LEVEL=INFO

# ============================================================
# SRT 워처 동작 (poll / mode / log)
# ============================================================
# 다음 검색까지 최소/최대 대기 시간(초), 사이에서 랜덤으로 쉰다
SRT_POLL_MIN=1
SRT_POLL_MAX=5

# true이면 한 번 검색/예약 시도 후 종료, false이면 계속 반복
SRT_ONCE=false

# 로그 및 artifacts 저장 루트 디렉토리
SRT_LOG_DIR=./runs

# 로그 레벨 (DEBUG / INFO / WARNING / ERROR)
SRT_LOG_LEVEL=INFO

# 동작 모드: search(조회만) / reserve(자동 예약)
SRT_MODE=reserve

# ============================================================
# 브라우저 모드 1) Playwright (내장 Chromium, 헤드리스 옵션)
#                — SRT 기본 모드. SRT_CDP_URL 이 비어 있으면 이쪽으로 동작.
# ============================================================
# Playwright headless 모드 (true=브라우저 창 안 뜸)
SRT_HEADLESS=true

# ============================================================
# 브라우저 모드 2) CDP (이미 실행 중인 Chrome 의 디버깅 포트에 연결)
#                — KTX 는 강제(필수). SRT 는 SRT_CDP_URL 설정 시 활성.
# ============================================================
# ─ KTX-A CDP ─
KTXA_CDP_PORT=9444
KTXA_CDP_USER_DATA_DIR=C:\Users\<your-user>\chrome-ktx-watcher
KTXA_CDP_STARTUP_TIMEOUT=20

# ─ SRT CDP (선택) ─
# 비워두면 Playwright 모드. 값이 있으면 그 Chrome 에 붙음.
#   예) http://localhost:9555
SRT_CDP_URL=

# ============================================================
# Microsoft Teams 알림 (team_mcp 사용)
# ============================================================
# Teams 알림 활성화 여부
TEAMS_ENABLED=true

# [보내는 주체] 인증된 사용자 이메일. 비워두면 auth.db 의 첫 번째 등록 사용자.
TEAMS_USER_EMAIL=

# [받는 대상] Teams 채팅 ID. 형식 예시:
#   - 48:notes                                → 나의 Notes (self, 본인에게)
#   - 19:<guid>_<guid>@unq.gbl.spaces        → 1:1 채팅
#   - 19:<thread>@thread.v2                  → 그룹 채팅 / 팀 채널
# 비워두면 자동으로 48:notes (나에게) 로 전송됨.
TEAMS_CHAT_ID=48:notes

# (선택) TEAMS_CHAT_ID 가 비어 있을 때, 이름(한글/영문)으로 채팅 검색.
# 사전에 team_mcp 로 sync_chats 가 한 번 실행되어 있어야 함.
TEAMS_RECIPIENT_NAME=

# 메시지 앞에 붙는 prefix
TEAMS_PREFIX=[KORAIL WATCHER]

# ============================================================
# Azure AD OAuth (team_mcp 가 Graph API 호출 시 사용)
# ============================================================
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI=http://localhost:5000/callback
AZURE_AUTHORITY=https://login.microsoftonline.com
AZURE_SCOPES=offline_access openid

# team_mcp 가 사용할 auth.db (이 프로젝트에 자체 보관)
DB_PATH=./team_mcp/database/auth.db
